FINPILOT_ENV=dev
FINPILOT_LOG_LEVEL=INFO
# FINPILOT_SCORING_CONFIG_PATH=config/scoring.yaml
FINPILOT_PROVIDER_MAX_RETRIES=2
FINPILOT_PROVIDER_BACKOFF_SECONDS=0.5
FINPILOT_DATABASE_URL=sqlite:///./finpilot.db
# Without a key the API still works and returns metrics + scores with degraded=true.
FINPILOT_OPENAI_API_KEY=
FINPILOT_OPENAI_MODEL=gpt-4o-mini
FINPILOT_OPENAI_TIMEOUT_SECONDS=30
FINPILOT_REPORT_CACHE_TTL_HOURS=24
FINPILOT_DATA_CACHE_TTL_HOURS=24
FINPILOT_ENABLE_UI=true
# Requests per minute per client IP. 0 disables.
FINPILOT_RATE_LIMIT_RESEARCH_PER_MINUTE=10
FINPILOT_RATE_LIMIT_DEFAULT_PER_MINUTE=60
FINPILOT_RATE_LIMIT_TRUST_PROXY=false
# Stops Gradio's telemetry and version-check requests.
GRADIO_ANALYTICS_ENABLED=False
